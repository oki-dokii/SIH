{
  "projectName": "string",
  "projectLocation": {
    "state": "string",
    "districts": ["array of strings"]
  },
  "projectSector": "string",
  "executiveSummary": "string (3-5 sentences)",
  "overallScore": "number (0-100)",
  "recommendation": "string (e.g., 'Approved with Conditions', 'Approved', 'Rejected', 'Needs Review')",
  "financialAnalysis": {
    "projectCost": {
      "capitalExpenditureLakhINR": "number or null",
      "workingCapitalLakhINR": "number or null",
      "culturalCostLakhINR": "number or null",
      "contingencyLakhINR": "number or null",
      "marginMoneyLakhINR": "number or null",
      "totalInitialInvestmentLakhINR": "number"
    },
    "capitalStructure": {
      "ncdcLoanLakhINR": "number or null",
      "subsidyLakhINR": "number or null",
      "subsidyMIDH_NHB_LakhINR": "number or null",
      "equityOrOwnContributionLakhINR": "number or null",
      "loanLakhINR": "number or null",
      "memberContributionLakhINR": "number or null",
      "termLoanInterestRatePercent": "number or null",
      "assumedInterestRatePercent": "number or null"
    },
    "capacityAndRevenue": "object with relevant capacity metrics",
    "costs": "object with cost breakdowns",
    "profitability": "object with profitability metrics",
    "returnsAndCoverage": {
      "avgDSCR": "number",
      "IRRPercent": "number"
    },
    "repaymentScheduleSummary": "object",
    "assumptions": ["array of strings"]
  },
  "timelineAnalysis": {
    "implementationDurationMonths": "number",
    "milestones": ["array of strings"],
    "operationsCalendar": "string",
    "timelineRisks": ["array of strings"]
  },
  "scopeAndObjectives": {
    "vision": "string",
    "mission": "string",
    "objectives": ["array of strings"],
    "processAndMachinery": ["array of strings"],
    "packagingAndChannels": "string"
  },
  "riskAssessment": [
    {
      "riskCategory": "string",
      "severity": "string (High/Medium/Low)",
      "description": "string",
      "evidence": "string"
    }
  ],
  "complianceCheck": {
    "statutoryAndPermits": ["array of strings"],
    "EHS": ["array of strings"],
    "labour": "string",
    "gapsOrUnknowns": ["array of strings"]
  },
  "environmentalImpact": {
    "overallRiskLevel": "string (High/Medium/Low)",
    "sensitiveAreaFlags": {
      "isInProtectedForest": "boolean",
      "isNearWaterBody": "boolean",
      "isInTribalLand": "boolean",
      "isInWildlifeCorridor": "boolean",
      "isInEcologicallySensitiveZone": "boolean"
    },
    "clearancesRequired": ["array of strings, e.g., 'Forest Clearance', 'Environmental Clearance', 'Wildlife Clearance'"],
    "environmentalConcerns": ["array of strings describing specific environmental issues"],
    "mitigationMeasures": ["array of strings describing planned mitigation"],
    "impactOnBiodiversity": "string or null",
    "waterResourceImpact": "string or null",
    "soilAndLandImpact": "string or null",
    "airQualityImpact": "string or null"
  },
  "inconsistencyDetection": {
    "hasInconsistencies": "boolean",
    "totalInconsistenciesFound": "number",
    "issues": [
      {
        "category": "string (Budget Mismatch/Timeline Conflict/Beneficiary Discrepancy/Data Inconsistency)",
        "severity": "string (Critical/High/Medium/Low)",
        "description": "string (detailed description of the inconsistency)",
        "location": "string (where in the DPR this issue was found, e.g., 'Financial Section Page 12')",
        "detectedValues": "string (the conflicting values or data found)",
        "impact": "string (how this affects the project evaluation)"
      }
    ]
  },
  "mdonerComplianceScoring": {
    "overallComplianceScore": "number (0-100, weighted average)",
    "scoringBreakdown": {
      "northEasternFocus": {
        "score": "number (0-100)",
        "weight": "number (e.g., 0.25 for 25%)",
        "findings": "string (evaluation details)",
        "met": "boolean"
      },
      "beneficiaryAlignment": {
        "score": "number (0-100)",
        "weight": "number (e.g., 0.20 for 20%)",
        "findings": "string (evaluation details)",
        "met": "boolean"
      },
      "environmentalCompliance": {
        "score": "number (0-100)",
        "weight": "number (e.g., 0.20 for 20%)",
        "findings": "string (evaluation details)",
        "met": "boolean"
      },
      "landAcquisition": {
        "score": "number (0-100)",
        "weight": "number (e.g., 0.15 for 15%)",
        "findings": "string (evaluation details)",
        "met": "boolean"
      },
      "documentationQuality": {
        "score": "number (0-100)",
        "weight": "number (e.g., 0.10 for 10%)",
        "findings": "string (evaluation details)",
        "met": "boolean"
      },
      "financialViability": {
        "score": "number (0-100)",
        "weight": "number (e.g., 0.10 for 10%)",
        "findings": "string (evaluation details)",
        "met": "boolean"
      }
    },
    "complianceGaps": ["array of strings describing specific compliance gaps"],
    "complianceStrengths": ["array of strings describing what the project does well"]
  },
  "smartRecommendations": {
    "criticalActions": ["array of strings - must-fix items before approval"],
    "improvementSuggestions": ["array of strings - recommended enhancements"],
    "bestPractices": ["array of strings - industry/MDoNER best practices to adopt"],
    "nextSteps": ["array of strings - specific actionable next steps in priority order"]
  }
}