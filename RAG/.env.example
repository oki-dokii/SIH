# ===========================
# ENVIRONMENT VARIABLES
# ===========================

# Cloud Backend URL (optional - for sync functionality)
# If not set, admin app will work offline-only
# Example for Render deployment: https://your-app-name.onrender.com
CLOUD_BACKEND_URL=

# Admin credentials for offline mode
# Used for admin authentication in the offline version
# Default credentials (change these in production):
ADMIN_ID=admin123
ADMIN_PASSWORD=123

# Add this to .env file in the root directory
# The server will automatically enable sync if CLOUD_BACKEND_URL is set
